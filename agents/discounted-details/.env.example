# Copy to .env for local runs. On Railway, set these as service variables. Never commit real values.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-5-5
DAILY_TOKEN_BUDGET=3000000

# --- Composio (Instagram + Messenger) ---
COMPOSIO_API_KEY=replace-me
# Either the Composio user the connections belong to, or the connected account IDs (preferred):
COMPOSIO_USER_ID=
COMPOSIO_IG_ACCOUNT_ID=ca_NZUIMjBqyvTc
COMPOSIO_FB_ACCOUNT_ID=ca_YEB2QPxKHft1
FB_PAGE_ID=945217095333956
IG_USER_ID=29680530378297751
POLL_SECONDS=60
POLL_SECONDS_NIGHT=120

# --- Google ---
# The full service-account JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
GOOGLE_SHEET_ID=1qA9A3eG4F00axogqyzATvI2ByFWZIBn8MHpjhN5LA8Q
GOOGLE_CALENDAR_ID=your-gmail-address
GOOGLE_MAPS_API_KEY=replace-me

# --- Telegram (owner alerts + approvals) ---
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_OWNER_CHAT_ID=your-numeric-chat-id-from-userinfobot
TELEGRAM_WEBHOOK_SECRET=random-32-characters-replace-me

# --- Runtime ---
PUBLIC_BASE_URL=https://dd-agent.up.railway.app
SLOT_SIGNING_KEY=random-64-hex-replace-me
DB_PATH=/data/agent.db
DEBOUNCE_SECONDS=20
OWNER_TAKEOVER_HOURS=12
SHADOW_MODE_DEFAULT=true
HEALTHCHECK_URL=
LOG_LEVEL=INFO
